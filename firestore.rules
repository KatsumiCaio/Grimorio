rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() <= 100
        && data.displayName is string && data.displayName.size() <= 200;
    }

    function isValidCampaign(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.system is string && data.system.size() <= 100
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500000));
    }

    function isValidCharacter(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.role is string && data.role.size() <= 200
        && data.type is string && (data.type == 'PJ' || data.type == 'NPC' || data.type == 'Monstro');
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.role is string && (data.role == 'user' || data.role == 'assistant' || data.role == 'system')
        && data.content is string && data.content.size() <= 100000;
    }

    // Health / Connection Test
    match /test/{testId} {
      allow read, write: if true;
    }

    // Users Collection (profiles)
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Campaigns Collection (shared world notebooks)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isValidId(campaignId) && isValidCampaign(request.resource.data);
      allow update: if isValidId(campaignId) && isValidCampaign(request.resource.data);
      allow delete: if isValidId(campaignId);

      // AI Copilot Chat Messages subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidId(messageId) && isValidChatMessage(request.resource.data);
        allow update: if isValidId(messageId) && isValidChatMessage(request.resource.data);
        allow delete: if isValidId(messageId);
      }
    }

    // Characters Collection (PJs, NPCs, Monsters)
    match /characters/{characterId} {
      allow read: if true;
      allow create: if isValidId(characterId) && isValidCharacter(request.resource.data);
      allow update: if isValidId(characterId) && isValidCharacter(request.resource.data);
      allow delete: if isValidId(characterId);
    }
  }
}

