{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile and account synchronization across multiple PCs and devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "avatarId": { "type": "string" },
        "color": { "type": "string" },
        "bio": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["id", "username", "displayName", "createdAt"]
    },
    "campaigns": {
      "title": "Campaign",
      "description": "Tabletop RPG campaigns containing world notes and rule systems",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "system": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "system", "notes"]
    },
    "characters": {
      "title": "Character",
      "description": "Player characters and NPCs sheets with attributes and resources",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "campaignId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "type": { "type": "string" },
        "attributes": { "type": "array" },
        "resources": { "type": "array" },
        "notes": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "campaignId", "name", "role", "type"]
    },
    "chatMessages": {
      "title": "ChatMessage",
      "description": "Conversation history messages between the DM and the AI Copilot for a campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string" },
        "system": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "campaignId", "userId", "role", "content", "timestamp"]
    },
    "testConnection": {
      "title": "TestConnection",
      "description": "Health check and connection verification document",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/test/{testId}": {
      "schema": "testConnection",
      "description": "Connection test and health check document"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and account settings"
    },
    "/campaigns/{campaignId}": {
      "schema": "campaigns",
      "description": "User campaign notebooks with lore notes and RPG system"
    },
    "/campaigns/{campaignId}/messages/{messageId}": {
      "schema": "chatMessages",
      "description": "Campaign AI Copilot chat messages history"
    },
    "/characters/{characterId}": {
      "schema": "characters",
      "description": "Player characters and NPC sheets"
    }
  }
}
